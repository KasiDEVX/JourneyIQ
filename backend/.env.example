# JourneyIQ Backend Configuration Template
# Copy this file to .env and configure for your environment.
# NEVER commit the real .env file to version control.

# =============================================================================
# ENVIRONMENT MODE
# =============================================================================
# Allowed values: development | production | test
# In production, wildcard CORS ('*') is strictly rejected by the server at startup.
ENVIRONMENT=development
DEBUG=false

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# Production (Managed PostgreSQL on Render/Railway/Supabase/AWS RDS):
# DATABASE_URL=postgresql://<user>:<password>@<host>:<port>/<dbname>?sslmode=require
#
# Local development (PostgreSQL):
# DATABASE_URL=postgresql://postgres:<password>@localhost:5432/journeyiq
#
# Local development zero-config fallback (SQLite):
# DATABASE_URL=sqlite:///backend/journeyiq.db
DATABASE_URL=sqlite:///backend/journeyiq.db

# Database Connection Pool Settings
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30

# =============================================================================
# CORS (Cross-Origin Resource Sharing)
# =============================================================================
# Comma-separated list of exact allowed origins (schemes + domains + optional port).
# Local development:
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173
#
# Production (e.g. deployed Vercel frontend):
# CORS_ORIGINS=https://<your-frontend-subdomain>.vercel.app
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# =============================================================================
# TRUSTED HOSTS
# =============================================================================
# Comma-separated list of valid HTTP Host header values.
# Local development:
# ALLOWED_HOSTS=localhost,127.0.0.1,testserver
#
# Production:
# ALLOWED_HOSTS=<your-api-subdomain>.onrender.com
ALLOWED_HOSTS=localhost,127.0.0.1,testserver
