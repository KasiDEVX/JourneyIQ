# JourneyIQ Frontend Configuration Template
# Copy this file to .env.local (for local development) or configure in your deployment platform (Vercel).
# NEVER put secrets into VITE_* variables — they are bundled into client JavaScript.

# Backend API Base URL
# Development (with Vite proxy): leave empty or set to http://localhost:8000
# Production: https://<production-api-domain> (e.g. https://api.journeyiq.example.com)
VITE_API_BASE_URL=http://localhost:8000
